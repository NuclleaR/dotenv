#!/usr/bin/env bash

# claude-install — Claude Desktop as an AppImage, built from Anthropic's .deb.
#
# Anthropic ships Claude Desktop for Linux only as a Debian package, and the
# package is a plain Electron bundle: the postinst does nothing an AppImage
# needs (AppArmor profile, apt repo registration, GNOME search provider). So
# this unpacks the .deb, wraps the bundle in an AppDir and packs it with
# appimagetool. That makes it run on Arch, Fedora, anything.
#
# Layout mirrors the Claude Code CLI next door (~/.local/bin/claude is a
# symlink into ~/.local/share/claude/versions/): the AppImage lives in
# ~/.local/share/claude-desktop/ under its version, and ~/.local/bin/claude-desktop
# points at it. The installed version is therefore the symlink target — no
# need to start Electron to ask.
#
# Every run checks the apt index for a newer version and rebuilds when there is
# one, so put it wherever you like to run updaters from.
#
# Installed into ~/.local/bin by bin/install.sh, and it runs from there with no
# repo next to it — hence the inline log helpers, as in fedora/apps.sh.

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

APT_BASE="https://downloads.claude.ai/claude-desktop/apt/stable"
APPIMAGETOOL_BASE="https://github.com/AppImage/appimagetool/releases/download/continuous"

APP_NAME="claude-desktop"
BIN_DIR="$HOME/.local/bin"
SHARE_DIR="$HOME/.local/share/$APP_NAME"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/$APP_NAME"
APPS_DIR="$HOME/.local/share/applications"
ICONS_DIR="$HOME/.local/share/icons/hicolor"
LINK="$BIN_DIR/$APP_NAME"

# The apt repo publishes amd64 and arm64 only; dpkg is not here to ask, so map
# the kernel's name ourselves. appimagetool names its builds after uname -m.
MACHINE="$(uname -m)"
case "$MACHINE" in
    x86_64)  DEB_ARCH="amd64" ;;
    aarch64) DEB_ARCH="arm64" ;;
    *)
        log_error "No Claude Desktop package for $MACHINE (amd64 and arm64 only)"
        exit 1
        ;;
esac

WORK=""
cleanup() {
    [[ -n "$WORK" ]] && rm -rf "$WORK"
}
trap cleanup EXIT

require() {
    local MISSING=()
    local TOOL
    for TOOL in curl bsdtar; do
        command -v "$TOOL" >/dev/null 2>&1 || MISSING+=("$TOOL")
    done
    if (( ${#MISSING[@]} )); then
        log_error "Missing: ${MISSING[*]}"
        log_info "Arch: pacman -S ${MISSING[*]/bsdtar/libarchive}    Fedora: dnf install ${MISSING[*]}"
        return 1
    fi
}

# Prints "<version> <pool path>" of the newest package in the apt index.
latest_release() {
    local INDEX FILE
    if ! INDEX="$(curl -fsSL "$APT_BASE/dists/stable/main/binary-$DEB_ARCH/Packages")"; then
        log_error "Could not fetch the package index from downloads.claude.ai"
        return 1
    fi
    FILE="$(echo "$INDEX" \
        | grep "^Filename: pool/main/c/$APP_NAME/${APP_NAME}_" \
        | sort -V | tail -n 1 | cut -d' ' -f2)"
    if [[ -z "$FILE" ]]; then
        log_error "The package index lists no $DEB_ARCH package"
        return 1
    fi
    # pool/main/c/claude-desktop/claude-desktop_2.110.0_amd64.deb -> 2.110.0
    local VERSION="${FILE##*/${APP_NAME}_}"
    VERSION="${VERSION%%_*}"
    echo "$VERSION $FILE"
}

appimage_name() {
    echo "Claude-$1-$MACHINE.AppImage"
}

# Version encoded in the symlink target; empty when nothing is installed or the
# link is dangling (a wiped ~/.local/share, say).
installed_version() {
    [[ -L "$LINK" && -e "$LINK" ]] || return 0
    local TARGET
    TARGET="$(basename "$(readlink -f "$LINK")")"
    TARGET="${TARGET#Claude-}"
    echo "${TARGET%-$MACHINE.AppImage}"
}

# appimagetool is itself an AppImage; kept in the cache dir rather than
# installed, since nothing else here needs it. Prints the path, so the log
# line has to go to stderr or the caller captures it as part of the path.
ensure_appimagetool() {
    local TOOL="$CACHE_DIR/appimagetool"
    if [[ ! -x "$TOOL" ]]; then
        mkdir -p "$CACHE_DIR"
        log_info "Downloading appimagetool into $CACHE_DIR" >&2
        curl -fsSL -o "$TOOL" "$APPIMAGETOOL_BASE/appimagetool-$MACHINE.AppImage"
        chmod 0755 "$TOOL"
    fi
    echo "$TOOL"
}

# $1 version, $2 pool path. Leaves the finished AppImage at $WORK/<name>.
build() {
    local VERSION="$1" POOL="$2"
    local APPDIR="$WORK/AppDir" DEB="$WORK/$APP_NAME.deb" OUT="$WORK/$(appimage_name "$VERSION")"
    local TOOL
    TOOL="$(ensure_appimagetool)"

    log_info "Downloading $APP_NAME $VERSION"
    curl -fL --progress-bar -o "$DEB" "$APT_BASE/$POOL"

    # A .deb is an ar archive holding data.tar.*; bsdtar reads both layers.
    # Only the payload is wanted — the control scripts are apt/AppArmor/GNOME
    # housekeeping that means nothing outside a dpkg system.
    log_info "Unpacking"
    mkdir -p "$APPDIR"
    bsdtar -xOf "$DEB" 'data.tar.*' | bsdtar -xf - -C "$APPDIR"

    # AppDir contract: AppRun + one .desktop + the icon it names, all at the
    # root. usr/bin/claude-desktop stays a symlink into usr/lib, so the
    # desktop file's bare Exec=claude-desktop resolves inside the image too.
    cat > "$APPDIR/AppRun" <<'EOF'
#!/bin/sh
# AppImage entry point: resolve our own mount point and exec the Electron binary from it.
HERE="$(dirname "$(readlink -f "$0")")"
exec "$HERE/usr/lib/claude-desktop/claude-desktop" "$@"
EOF
    chmod 0755 "$APPDIR/AppRun"
    cp "$APPDIR/usr/share/applications/com.anthropic.Claude.desktop" "$APPDIR/$APP_NAME.desktop"
    cp "$APPDIR/usr/share/icons/hicolor/256x256/apps/$APP_NAME.png" "$APPDIR/$APP_NAME.png"
    ln -sf "$APP_NAME.png" "$APPDIR/.DirIcon"

    # APPIMAGE_EXTRACT_AND_RUN lets appimagetool itself run where FUSE is
    # absent (a container, a fresh box without fuse2). Its output is a
    # squashfs file listing, so only shown when the build fails.
    log_info "Packing (this takes a minute)"
    if ! ARCH="$MACHINE" APPIMAGE_EXTRACT_AND_RUN=1 \
        "$TOOL" --comp zstd "$APPDIR" "$OUT" > "$WORK/appimagetool.log" 2>&1; then
        tail -n 30 "$WORK/appimagetool.log"
        log_error "appimagetool failed"
        return 1
    fi

    # Electron answers --version without opening a window, so this proves the
    # image mounts and the bundle runs before it replaces the installed one.
    local GOT
    if GOT="$("$OUT" --version 2>/dev/null)" && [[ "$GOT" == "$VERSION" ]]; then
        log_success "Built $(basename "$OUT")"
    else
        log_error "The built AppImage does not run (--version printed '${GOT:-nothing}')"
        return 1
    fi
}

# Moves the built image into place, points the symlink at it, drops the
# versions it replaces.
install_appimage() {
    local VERSION="$1"
    local NAME
    NAME="$(appimage_name "$VERSION")"

    mkdir -p "$SHARE_DIR" "$BIN_DIR"
    mv "$WORK/$NAME" "$SHARE_DIR/$NAME"
    ln -sfn "$SHARE_DIR/$NAME" "$LINK"

    local OLD
    for OLD in "$SHARE_DIR"/Claude-*.AppImage; do
        [[ -e "$OLD" && "$OLD" != "$SHARE_DIR/$NAME" ]] || continue
        rm -f "$OLD"
        log_info "Removed $(basename "$OLD")"
    done
    log_success "$LINK -> $SHARE_DIR/$NAME"
}

# Menu entry and icons. An AppImage registers nothing on its own, and without
# the .desktop file there is no launcher and the claude:// URL the browser
# sends back after sign-in has nowhere to go. Icons go to the user's hicolor
# theme, which is what KDE, GNOME and everything else looks in; the .deb ships
# every size, so install them all rather than let the panel upscale one.
integrate_desktop() {
    local APPDIR="$WORK/AppDir"
    local SIZE_DIR SIZE
    for SIZE_DIR in "$APPDIR"/usr/share/icons/hicolor/*/apps; do
        SIZE="$(basename "$(dirname "$SIZE_DIR")")"
        mkdir -p "$ICONS_DIR/$SIZE/apps"
        cp "$SIZE_DIR/$APP_NAME.png" "$ICONS_DIR/$SIZE/apps/$APP_NAME.png"
    done

    # Launchers do not have ~/.local/bin on PATH; every Exec (main entry and
    # the two desktop actions) gets the absolute symlink instead.
    mkdir -p "$APPS_DIR"
    sed "s|^Exec=$APP_NAME|Exec=$LINK|" \
        "$APPDIR/usr/share/applications/com.anthropic.Claude.desktop" \
        > "$APPS_DIR/$APP_NAME.desktop"

    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$APPS_DIR" 2>/dev/null
    command -v xdg-mime >/dev/null 2>&1 && xdg-mime default "$APP_NAME.desktop" x-scheme-handler/claude 2>/dev/null
    # KDE caches menus and icons in sycoca; without a rebuild the new entry
    # shows up whenever it feels like it.
    local KBUILD
    for KBUILD in kbuildsycoca6 kbuildsycoca5; do
        if command -v "$KBUILD" >/dev/null 2>&1; then
            "$KBUILD" >/dev/null 2>&1 || true
            break
        fi
    done
    log_success "Menu entry and icons installed"
}

status() {
    local INSTALLED LATEST
    INSTALLED="$(installed_version)"
    echo "Installed: ${INSTALLED:-none}"
    if LATEST="$(latest_release)"; then
        echo "Latest:    ${LATEST%% *}"
    fi
}

uninstall() {
    rm -f "$LINK" "$APPS_DIR/$APP_NAME.desktop"
    rm -rf "$SHARE_DIR"
    local ICON
    for ICON in "$ICONS_DIR"/*/apps/"$APP_NAME.png"; do
        [[ -e "$ICON" ]] && rm -f "$ICON"
    done
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$APPS_DIR" 2>/dev/null
    log_success "Claude Desktop removed (the build cache in $CACHE_DIR and ~/.config/Claude are kept)"
}

usage() {
    cat <<EOF
claude-install — Claude Desktop as an AppImage, built from Anthropic's .deb

Usage:
  claude-install            install, or update when the apt index has a
                            newer version; a no-op when already current
  claude-install -f         rebuild and reinstall the latest even if current
  claude-install status     installed vs latest version
  claude-install uninstall  remove the AppImage, the symlink and the menu entry
  claude-install help

Files:
  $LINK  -> $SHARE_DIR/Claude-<version>-$MACHINE.AppImage
  $APPS_DIR/$APP_NAME.desktop
  $ICONS_DIR/*/apps/$APP_NAME.png
EOF
}

main() {
    local CMD="${1:-install}"
    local FORCE=0

    case "$CMD" in
        install) ;;
        -f | --force) FORCE=1 ;;
        status | st) status; return ;;
        uninstall) uninstall; return ;;
        help | -h | --help) usage; return ;;
        *)
            log_error "Unknown command: $CMD"
            echo ""
            usage
            return 1
            ;;
    esac

    require || return 1

    local LATEST VERSION POOL INSTALLED
    LATEST="$(latest_release)" || return 1
    VERSION="${LATEST%% *}"
    POOL="${LATEST#* }"
    INSTALLED="$(installed_version)"

    if [[ "$INSTALLED" == "$VERSION" && $FORCE -eq 0 ]]; then
        log_success "Claude Desktop $VERSION is already installed"
        return 0
    fi
    if [[ "$INSTALLED" == "$VERSION" ]]; then
        log_info "Rebuilding Claude Desktop $VERSION"
    elif [[ -n "$INSTALLED" ]]; then
        log_info "Update: $INSTALLED -> $VERSION"
    else
        log_info "Installing Claude Desktop $VERSION"
    fi

    WORK="$(mktemp -d)"
    build "$VERSION" "$POOL" || return 1
    install_appimage "$VERSION"
    integrate_desktop

    log_success "Claude Desktop $VERSION ready — run: $APP_NAME"
}

if [[ -z "${BASH_SOURCE[0]:-}" || "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
