#!/usr/bin/env bash

# deb2app — desktop apps shipped only as .deb, rebuilt as AppImages.
#
#   deb2app claude      Claude Desktop (Anthropic)
#   deb2app codex       ChatGPT / Codex desktop (OpenAI)
#
# Both vendors ship their Linux desktop app as a Debian package, and both
# packages are plain Electron bundles: the postinst does nothing an AppImage
# needs (AppArmor profile, apt repo registration, GNOME search provider). So
# this unpacks the .deb, wraps the bundle in an AppDir and packs it with
# appimagetool. That makes it run on Arch, Fedora, anything.
#
# Layout mirrors the Claude Code CLI next door (~/.local/bin/claude is a
# symlink into ~/.local/share/claude/versions/): the AppImage lives in
# ~/.local/share/<command>/ under its version, and ~/.local/bin/<command>
# points at it. The installed version is therefore the symlink target — no
# need to start Electron to ask.
#
# Every run checks the vendor's apt index for a newer version and rebuilds
# when there is one, so put it wherever you like to run updaters from.
#
# Installed into ~/.local/bin by bin/install.sh, and it runs from there with no
# repo next to it — hence the inline log helpers, as in fedora/apps.sh.

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

APPIMAGETOOL_BASE="https://github.com/AppImage/appimagetool/releases/download/continuous"

BIN_DIR="$HOME/.local/bin"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/deb2app"
APPS_DIR="$HOME/.local/share/applications"

# The apt repos publish amd64 and arm64 only; dpkg is not here to ask, so map
# the kernel's name ourselves. appimagetool names its builds after uname -m.
MACHINE="$(uname -m)"
case "$MACHINE" in
    x86_64)  DEB_ARCH="amd64" ;;
    aarch64) DEB_ARCH="arm64" ;;
    *)
        log_error "No packages for $MACHINE (amd64 and arm64 only)"
        exit 1
        ;;
esac

# --- per-app table -----------------------------------------------------------
# What the .deb does not tell us. Everything else — the .desktop file, the icon
# name and sizes — is read from the package payload at build time. The command
# name is deliberately not the package name: ~/.local/bin/claude and
# ~/.local/bin/codex are the CLIs.
#
#   APT_BASE  apt repo root; <root>/dists/stable/main/binary-<arch>/Packages
#             is the index, Filename: entries are relative to the root
#   PKG       Package: name in that index; also usr/bin/<PKG> inside the deb
#   CMD       the command in ~/.local/bin and the name of the share dir
#   TITLE     AppImage file name prefix
#   SCHEME    the app's own URL scheme, what the browser sends back after
#             sign-in. Only this one is registered — chatgpt.desktop also
#             claims http/https and a few office types, which is not ours to
#             hand it by default.
select_app() {
    case "$1" in
        claude)
            APT_BASE="https://downloads.claude.ai/claude-desktop/apt/stable"
            PKG="claude-desktop"
            CMD="claude-desktop"
            TITLE="Claude"
            SCHEME="claude"
            ;;
        codex)
            APT_BASE="https://persistent.oaistatic.com/codex-app-prod/linux/deb"
            PKG="chatgpt"
            CMD="codex-desktop"
            TITLE="ChatGPT"
            SCHEME="codex"
            ;;
        *)
            return 1
            ;;
    esac
    SHARE_DIR="$HOME/.local/share/$CMD"
    LINK="$BIN_DIR/$CMD"
}

WORK=""
# An if, not `[[ ]] &&`: a failing last command in an EXIT trap becomes the
# script's exit status, and status/help with no build dir would exit 1.
cleanup() {
    if [[ -n "$WORK" ]]; then
        rm -rf "$WORK"
    fi
}
trap cleanup EXIT

require() {
    local MISSING=()
    local TOOL
    for TOOL in curl bsdtar; do
        command -v "$TOOL" >/dev/null 2>&1 || MISSING+=("$TOOL")
    done
    if (( ${#MISSING[@]} )); then
        log_error "Missing: ${MISSING[*]}"
        log_info "Arch: pacman -S ${MISSING[*]/bsdtar/libarchive}    Fedora: dnf install ${MISSING[*]}"
        return 1
    fi
}

# Prints "<version> <pool path>" of the newest package in the apt index.
latest_release() {
    local INDEX FILE
    if ! INDEX="$(curl -fsSL "$APT_BASE/dists/stable/main/binary-$DEB_ARCH/Packages")"; then
        log_error "Could not fetch the package index from $APT_BASE"
        return 1
    fi
    FILE="$(echo "$INDEX" \
        | grep "^Filename: .*/${PKG}_" \
        | sort -V | tail -n 1 | cut -d' ' -f2)"
    if [[ -z "$FILE" ]]; then
        log_error "The package index lists no $DEB_ARCH package for $PKG"
        return 1
    fi
    # pool/main/c/claude-desktop/claude-desktop_2.110.0_amd64.deb -> 2.110.0
    local VERSION="${FILE##*/${PKG}_}"
    VERSION="${VERSION%%_*}"
    echo "$VERSION $FILE"
}

appimage_name() {
    echo "$TITLE-$1-$MACHINE.AppImage"
}

# Version encoded in the symlink target; empty when nothing is installed or the
# link is dangling (a wiped ~/.local/share, say).
installed_version() {
    [[ -L "$LINK" && -e "$LINK" ]] || return 0
    local TARGET
    TARGET="$(basename "$(readlink -f "$LINK")")"
    TARGET="${TARGET#$TITLE-}"
    echo "${TARGET%-$MACHINE.AppImage}"
}

# appimagetool is itself an AppImage; kept in the cache dir rather than
# installed, since nothing else here needs it. Prints the path, so the log
# line has to go to stderr or the caller captures it as part of the path.
ensure_appimagetool() {
    local TOOL="$CACHE_DIR/appimagetool"
    if [[ ! -x "$TOOL" ]]; then
        mkdir -p "$CACHE_DIR"
        log_info "Downloading appimagetool into $CACHE_DIR" >&2
        curl -fsSL -o "$TOOL" "$APPIMAGETOOL_BASE/appimagetool-$MACHINE.AppImage"
        chmod 0755 "$TOOL"
    fi
    echo "$TOOL"
}

# The one .desktop file the package ships, and the icon it names. Both vendors
# ship exactly one; the icon is either a hicolor set (claude) or a single
# pixmap (chatgpt). Sets DESKTOP_SRC, ICON_NAME, ICON_FILES (largest last).
locate_desktop_bits() {
    local APPDIR="$1"
    local FOUND=("$APPDIR"/usr/share/applications/*.desktop)
    if (( ${#FOUND[@]} != 1 )) || [[ ! -f "${FOUND[0]}" ]]; then
        log_error "Expected exactly one .desktop file in the package, found ${#FOUND[@]}"
        return 1
    fi
    DESKTOP_SRC="${FOUND[0]}"
    ICON_NAME="$(sed -n 's/^Icon=//p' "$DESKTOP_SRC" | head -n 1)"
    if [[ -z "$ICON_NAME" ]]; then
        log_error "$(basename "$DESKTOP_SRC") names no Icon="
        return 1
    fi

    ICON_FILES=()
    local F
    for F in "$APPDIR"/usr/share/icons/hicolor/*/apps/"$ICON_NAME".png \
             "$APPDIR/usr/share/pixmaps/$ICON_NAME.png"; do
        [[ -f "$F" ]] && ICON_FILES+=("$F")
    done
    if (( ${#ICON_FILES[@]} == 0 )); then
        log_error "No PNG icon named $ICON_NAME in the package"
        return 1
    fi
    # Sort so the largest is last — the one that is used.
    mapfile -t ICON_FILES < <(printf '%s\n' "${ICON_FILES[@]}" | sort -V)
}

# $1 version, $2 pool path. Leaves the finished AppImage at $WORK/<name>.
build() {
    local VERSION="$1" POOL="$2"
    local APPDIR="$WORK/AppDir" DEB="$WORK/$PKG.deb" OUT="$WORK/$(appimage_name "$VERSION")"
    local TOOL
    TOOL="$(ensure_appimagetool)"

    log_info "Downloading $PKG $VERSION"
    curl -fL --progress-bar -o "$DEB" "$APT_BASE/$POOL"

    # A .deb is an ar archive holding data.tar.*; bsdtar reads both layers.
    # Only the payload is wanted — the control scripts are apt/AppArmor/GNOME
    # housekeeping that means nothing outside a dpkg system.
    log_info "Unpacking"
    mkdir -p "$APPDIR"
    bsdtar -xOf "$DEB" 'data.tar.*' | bsdtar -xf - -C "$APPDIR"
    locate_desktop_bits "$APPDIR" || return 1

    # AppDir contract: AppRun + one .desktop + the icon it names, all at the
    # root. usr/bin/<PKG> is the vendor's own entry point (a symlink into
    # usr/lib, or a launcher script there) and resolves inside the mounted
    # image, so AppRun just execs it and the .desktop's bare Exec= is fine too.
    cat > "$APPDIR/AppRun" <<EOF
#!/bin/sh
# AppImage entry point: resolve our own mount point and exec the vendor's launcher from it.
HERE="\$(dirname "\$(readlink -f "\$0")")"
exec "\$HERE/usr/bin/$PKG" "\$@"
EOF
    chmod 0755 "$APPDIR/AppRun"
    cp "$DESKTOP_SRC" "$APPDIR/$CMD.desktop"
    cp "${ICON_FILES[-1]}" "$APPDIR/$ICON_NAME.png"
    ln -sf "$ICON_NAME.png" "$APPDIR/.DirIcon"

    # APPIMAGE_EXTRACT_AND_RUN lets appimagetool itself run where FUSE is
    # absent (a container, a fresh box without fuse2). Its output is a
    # squashfs file listing, so only shown when the build fails.
    log_info "Packing (this takes a minute)"
    if ! ARCH="$MACHINE" APPIMAGE_EXTRACT_AND_RUN=1 \
        "$TOOL" --comp zstd "$APPDIR" "$OUT" > "$WORK/appimagetool.log" 2>&1; then
        tail -n 30 "$WORK/appimagetool.log"
        log_error "appimagetool failed"
        return 1
    fi

    # Electron answers --version without opening a window, so this proves the
    # image mounts and the bundle runs before it replaces the installed one.
    local GOT
    if GOT="$("$OUT" --version 2>/dev/null)" && [[ "$GOT" == "$VERSION" ]]; then
        log_success "Built $(basename "$OUT")"
    else
        log_error "The built AppImage does not run (--version printed '${GOT:-nothing}')"
        return 1
    fi
}

# Moves the built image into place, points the symlink at it, drops the
# versions it replaces.
install_appimage() {
    local VERSION="$1"
    local NAME
    NAME="$(appimage_name "$VERSION")"

    mkdir -p "$SHARE_DIR" "$BIN_DIR"
    mv "$WORK/$NAME" "$SHARE_DIR/$NAME"
    ln -sfn "$SHARE_DIR/$NAME" "$LINK"

    local OLD
    for OLD in "$SHARE_DIR/$TITLE"-*.AppImage; do
        [[ -e "$OLD" && "$OLD" != "$SHARE_DIR/$NAME" ]] || continue
        rm -f "$OLD"
        log_info "Removed $(basename "$OLD")"
    done
    log_success "$LINK -> $SHARE_DIR/$NAME"
}

# Menu entry and icon. An AppImage registers nothing on its own, and without
# the .desktop file there is no launcher and the URL the browser sends back
# after sign-in has nowhere to go.
#
# The icon is referenced by absolute path, not installed into hicolor under
# its name. Two reasons, both seen on KDE: a name is looked up in the user's
# icon theme first, and KDE tries the name with its last "-part" cut off
# before it ever falls back to hicolor — so Icon=claude-desktop resolved to
# MacTahoe's own claude.svg. And a pixmap-only package (chatgpt, one
# 1024x1024 PNG) has no hicolor size directory that fits: index.theme stops
# at 512, anything else is invisible. A path sidesteps both.
integrate_desktop() {
    local ICON="$SHARE_DIR/$ICON_NAME.png"
    cp "${ICON_FILES[-1]}" "$ICON"

    # Launchers do not have ~/.local/bin on PATH; every Exec (main entry and
    # any desktop actions) gets the absolute symlink instead. http/https come
    # out of MimeType: chatgpt.desktop claims them, and on a box with no
    # browser set as default that makes the app the handler for every link.
    mkdir -p "$APPS_DIR"
    sed -e "s|^Exec=$PKG\b|Exec=$LINK|" \
        -e "s|^Icon=.*|Icon=$ICON|" \
        -e '/^MimeType=/s|x-scheme-handler/https\{0,1\};||g' \
        "$DESKTOP_SRC" > "$APPS_DIR/$CMD.desktop"

    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$APPS_DIR" 2>/dev/null
    command -v xdg-mime >/dev/null 2>&1 && xdg-mime default "$CMD.desktop" "x-scheme-handler/$SCHEME" 2>/dev/null
    # KDE caches menus and icons in sycoca; without a rebuild the new entry
    # shows up whenever it feels like it.
    local KBUILD
    for KBUILD in kbuildsycoca6 kbuildsycoca5; do
        if command -v "$KBUILD" >/dev/null 2>&1; then
            "$KBUILD" >/dev/null 2>&1 || true
            break
        fi
    done
    log_success "Menu entry and icon installed"
}

status() {
    local INSTALLED LATEST
    INSTALLED="$(installed_version)"
    echo "$CMD"
    echo "  Installed: ${INSTALLED:-none}"
    if LATEST="$(latest_release)"; then
        echo "  Latest:    ${LATEST%% *}"
    fi
}

# Everything integrate_desktop touched, reversed. xdg-mime wrote our
# .desktop into mimeapps.list; left there it is a dangling default the
# next handler for that scheme has to fight. The entry can be a list
# (a.desktop;b.desktop;), so cut our name out of it and drop the line only
# when nothing is left. Both locations: ~/.config is current, the one next
# to the .desktop files is where older tools still write.
strip_mimeapps() {
    local F
    for F in "${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list" "$APPS_DIR/mimeapps.list"; do
        [[ -f "$F" ]] || continue
        if grep -q "$CMD\.desktop" "$F"; then
            sed -i -e "s/$CMD\.desktop;\{0,1\}//g" -e '/^[^=[]*=$/d' "$F"
            log_info "Removed $CMD.desktop from $F"
        fi
    done
}

uninstall() {
    # Icons by name are what the earlier version installed; nothing writes
    # them now, but a box set up back then still has them.
    local ICON_NAME=""
    if [[ -f "$APPS_DIR/$CMD.desktop" ]]; then
        ICON_NAME="$(sed -n 's/^Icon=//p' "$APPS_DIR/$CMD.desktop" | head -n 1)"
        ICON_NAME="$(basename "${ICON_NAME%.png}")"
    fi
    if [[ -n "$ICON_NAME" ]]; then
        local ICON
        for ICON in "$HOME/.local/share/icons/hicolor"/*/apps/"$ICON_NAME.png"; do
            [[ -e "$ICON" ]] && rm -f "$ICON"
        done
    fi

    rm -f "$LINK" "$APPS_DIR/$CMD.desktop"
    rm -rf "$SHARE_DIR"
    strip_mimeapps
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$APPS_DIR" 2>/dev/null
    local KBUILD
    for KBUILD in kbuildsycoca6 kbuildsycoca5; do
        if command -v "$KBUILD" >/dev/null 2>&1; then
            "$KBUILD" >/dev/null 2>&1 || true
            break
        fi
    done
    log_success "$CMD removed (the build cache in $CACHE_DIR and the app's own ~/.config data are kept)"
}

usage() {
    cat <<EOF
deb2app — desktop apps shipped only as .deb, rebuilt as AppImages

Usage:
  deb2app <app>            install, or update when the vendor's apt index has
                           a newer version; a no-op when already current
  deb2app <app> -f         rebuild and reinstall the latest even if current
  deb2app <app> status     installed vs latest version
  deb2app <app> uninstall  remove the AppImage, the symlink and the menu entry
  deb2app help

Apps:
  claude    Claude Desktop            -> ~/.local/bin/claude-desktop
  codex     ChatGPT / Codex desktop   -> ~/.local/bin/codex-desktop

Files, per app:
  ~/.local/bin/<command>  -> ~/.local/share/<command>/<Title>-<version>-$MACHINE.AppImage
  ~/.local/share/applications/<command>.desktop
  ~/.local/share/<command>/<icon>.png
EOF
}

main() {
    local APP="${1:-help}"
    case "$APP" in
        help | -h | --help)
            usage
            return
            ;;
    esac
    if ! select_app "$APP"; then
        log_error "Unknown app: $APP"
        echo ""
        usage
        return 1
    fi
    shift

    local CMD_ARG="${1:-install}"
    local FORCE=0
    case "$CMD_ARG" in
        install) ;;
        -f | --force) FORCE=1 ;;
        status | st) status; return ;;
        uninstall) uninstall; return ;;
        help | -h | --help) usage; return ;;
        *)
            log_error "Unknown command: $CMD_ARG"
            echo ""
            usage
            return 1
            ;;
    esac

    require || return 1

    local LATEST VERSION POOL INSTALLED
    LATEST="$(latest_release)" || return 1
    VERSION="${LATEST%% *}"
    POOL="${LATEST#* }"
    INSTALLED="$(installed_version)"

    if [[ "$INSTALLED" == "$VERSION" && $FORCE -eq 0 ]]; then
        log_success "$CMD $VERSION is already installed"
        return 0
    fi
    if [[ "$INSTALLED" == "$VERSION" ]]; then
        log_info "Rebuilding $CMD $VERSION"
    elif [[ -n "$INSTALLED" ]]; then
        log_info "Update: $INSTALLED -> $VERSION"
    else
        log_info "Installing $CMD $VERSION"
    fi

    WORK="$(mktemp -d)"
    build "$VERSION" "$POOL" || return 1
    install_appimage "$VERSION"
    integrate_desktop

    log_success "$CMD $VERSION ready — run: $CMD"
}

if [[ -z "${BASH_SOURCE[0]:-}" || "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
