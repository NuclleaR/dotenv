#!/usr/bin/env bash

# signing-secrets — sets the Android release signing secrets in GitHub repositories:
# SIGNING_KEYSTORE (the keystore, base64), SIGNING_STORE_PASSWORD, SIGNING_KEY_ALIAS and SIGNING_KEY_PASSWORD,
# for workflows that sign release builds with -Pandroid.injected.signing.*.
#
#   signing-secrets [repo ...]
#   bash <(curl -fsSL https://raw.githubusercontent.com/NuclleaR/dotenv/main/bin/signing-secrets) [repo ...]
#
# Repositories are owner/repo, or just repo for your own; without arguments it asks. The keystore and passwords
# come from ~/.gradle/gradle.properties (release.storeFile, release.storePassword, release.keyAlias,
# release.keyPassword), the same ones Gradle signs local release builds with; whatever is missing there is asked
# for. Nothing goes anywhere but to GitHub, through gh.
#
# Installed into ~/.local/bin by bin/install.sh, and it runs from there with no repo next to it — hence the inline
# log helpers, as in fedora/apps.sh.

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

die() {
    log_error "$1"
    exit 1
}

# Prompts read the terminal, not stdin, so this also works when piped into bash
ask() {
    local ANSWER=""
    read -r -p "$1" ANSWER </dev/tty || true
    printf '%s' "$ANSWER"
}

ask_secret() {
    local ANSWER=""
    read -rs -p "$1" ANSWER </dev/tty || true
    echo >&2
    printf '%s' "$ANSWER"
}

# A value from ~/.gradle/gradle.properties, empty when it isn't there
prop() {
    local PROPS="$HOME/.gradle/gradle.properties"
    if [[ -f "$PROPS" ]]; then
        sed -n "s/^$1=//p" "$PROPS" | tail -n 1
    fi
}

main() {
    command -v gh >/dev/null || die "needs the GitHub CLI: https://cli.github.com"
    command -v keytool >/dev/null || die "needs keytool, which comes with a JDK"
    gh auth status >/dev/null 2>&1 || die "not signed in to GitHub: run gh auth login"

    local STORE_FILE KEY_ALIAS STORE_PASSWORD KEY_PASSWORD FINGERPRINT
    STORE_FILE="$(prop release.storeFile)"
    STORE_FILE="${STORE_FILE:-$(ask "Keystore file: ")}"
    STORE_FILE="${STORE_FILE/#\~/$HOME}"
    [[ -f "$STORE_FILE" ]] || die "no keystore at $STORE_FILE"

    KEY_ALIAS="$(prop release.keyAlias)"
    KEY_ALIAS="${KEY_ALIAS:-$(ask "Key alias: ")}"
    STORE_PASSWORD="$(prop release.storePassword)"
    STORE_PASSWORD="${STORE_PASSWORD:-$(ask_secret "Keystore password: ")}"
    KEY_PASSWORD="$(prop release.keyPassword)"
    KEY_PASSWORD="${KEY_PASSWORD:-$(ask_secret "Key password (empty: same as the keystore's): ")}"
    KEY_PASSWORD="${KEY_PASSWORD:-$STORE_PASSWORD}"

    # A wrong password or alias would only show up as a failed release build, so check them here. keytool reads
    # the password from the environment, never from its arguments, which other users can see.
    export SIGNING_CHECK_PASSWORD="$STORE_PASSWORD"
    keytool -list -keystore "$STORE_FILE" -storepass:env SIGNING_CHECK_PASSWORD -alias "$KEY_ALIAS" >/dev/null 2>&1 ||
        die "the keystore password or the alias \"$KEY_ALIAS\" is wrong"
    FINGERPRINT="$(keytool -list -v -keystore "$STORE_FILE" -storepass:env SIGNING_CHECK_PASSWORD -alias "$KEY_ALIAS" 2>/dev/null |
        sed -n 's/^[[:space:]]*SHA256: //p' | head -n 1 || true)"
    unset SIGNING_CHECK_PASSWORD

    local REPOS=("$@")
    if [[ ${#REPOS[@]} -eq 0 ]]; then
        read -r -a REPOS -p "Repositories (owner/repo or repo, separated by spaces): " </dev/tty || true
    fi
    [[ ${#REPOS[@]} -gt 0 ]] || die "no repositories given"

    local ME REPO FAILED=0
    ME="$(gh api user --jq .login)"
    log_info "Keystore $STORE_FILE, alias $KEY_ALIAS${FINGERPRINT:+, SHA-256 $FINGERPRINT}"
    for REPO in "${REPOS[@]}"; do
        [[ "$REPO" == */* ]] || REPO="$ME/$REPO"
        if ! gh repo view "$REPO" >/dev/null 2>&1; then
            log_warning "$REPO: not found or no access, skipped"
            FAILED=1
            continue
        fi
        # Values go through stdin, never as arguments, so they don't show up in the process list
        base64 <"$STORE_FILE" | tr -d '\n' | gh secret set SIGNING_KEYSTORE -R "$REPO"
        printf '%s' "$STORE_PASSWORD" | gh secret set SIGNING_STORE_PASSWORD -R "$REPO"
        printf '%s' "$KEY_ALIAS" | gh secret set SIGNING_KEY_ALIAS -R "$REPO"
        printf '%s' "$KEY_PASSWORD" | gh secret set SIGNING_KEY_PASSWORD -R "$REPO"
        log_success "$REPO: secrets set"
    done
    return "$FAILED"
}

if [[ -z "${BASH_SOURCE[0]:-}" || "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
