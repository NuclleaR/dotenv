#!/usr/bin/env bash

# vpn — a small wrapper around the tailscale CLI.
#
# The tailscale commands are fine on their own; what this saves is remembering
# which of them want root, where the Mac App Store build hides the binary, and
# that a machine should join a tailnet under its own short hostname instead of
# whatever Tailscale guesses from the system name.
#
# Installed into ~/.local/bin by bin/install.sh, and it runs from there with no
# repo next to it — hence the inline log helpers, as in fedora/apps.sh.

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

# On Linux and for the standalone macOS build the CLI is on PATH; the Mac App
# Store build keeps it inside the bundle. https://tailscale.com/kb/1080/cli
find_tailscale() {
    if command -v tailscale >/dev/null 2>&1; then
        command -v tailscale
        return 0
    fi

    local CANDIDATE
    for CANDIDATE in \
        /usr/local/bin/tailscale \
        /Applications/Tailscale.app/Contents/MacOS/Tailscale; do
        if [[ -x "$CANDIDATE" ]]; then
            echo "$CANDIDATE"
            return 0
        fi
    done

    return 1
}

usage() {
    cat <<EOF
vpn — wrapper around the tailscale CLI

Usage:
  vpn create [name]   put this machine on your tailnet under "name"
                      (default: $(hostname -s)). Run once, on the machine
                      you want to reach — a box, a server
  vpn up [account]    connect, accepting the routes the tailnet advertises.
                      With an account name, move to that tailnet first,
                      logging in if this machine has never used it.
                      Further flags go to "tailscale set", e.g.
                      vpn up work --exit-node=
  vpn down            disconnect, leaving the daemon running
  vpn status          who is on the tailnet, and how each peer is reached
  vpn ls              the accounts this machine is logged into
  vpn ip              this machine's tailnet addresses
  vpn help            this help

Examples:
  vpn create lbox     on the box, once
  vpn up personal     on the laptop: into the personal tailnet
  vpn up work         back into the work one

A machine can only carry traffic for one tailnet at a time, which is why
"up" takes the account to be on. https://tailscale.com/kb/1225/fast-user-switching
EOF
}

main() {
    local TS
    if ! TS="$(find_tailscale)"; then
        log_error "tailscale is not installed"
        log_info "Fedora: fedora/apps.sh -i tailscale"
        log_info "macOS:  https://tailscale.com/download/mac"
        return 1
    fi

    # Everything that changes state wants root on Linux, unless the daemon was
    # handed to this user with `tailscale set --operator=\$USER`. macOS needs
    # none of it.
    local SUDO=""
    if [[ "$(uname -s)" == "Linux" && "$(id -u)" -ne 0 ]]; then
        SUDO="sudo"
    fi

    local CMD="${1:-help}"
    shift || true

    case "$CMD" in
        up)
            local ACCOUNT=""
            if [[ -n "${1:-}" && "${1}" != -* ]]; then
                ACCOUNT="$1"
                shift
            fi

            if [[ -n "$ACCOUNT" ]]; then
                # `switch` fails when this machine has never used that account,
                # and that is the case worth handling: log in, which both
                # creates the profile under this nickname and brings it up.
                if ! $SUDO "$TS" switch "$ACCOUNT" >/dev/null 2>&1; then
                    log_info "No account \"$ACCOUNT\" here yet — logging in to create it"
                    log_info "This prints a URL; open it and sign in as that account"
                    $SUDO "$TS" login --nickname="$ACCOUNT"
                else
                    log_info "Now on \"$ACCOUNT\""
                fi
            fi

            # `up` itself stays flagless on purpose. Given even one flag it
            # treats the flags as the complete set of desired settings and
            # errors out on anything an unspecified one would reset.
            $SUDO "$TS" up --accept-routes "$@"
            ;;
        down)
            $SUDO "$TS" down "$@"
            ;;
        status | st)
            "$TS" status "$@"
            ;;
        create)
            local NAME="${1:-$(hostname -s)}"

            # Running this on a machine that is already on a tailnet renames
            # its node there rather than creating anything. Easy to do by
            # accident when the work VPN is Tailscale too. A non-empty DNSName
            # is the test: the daemon only has one once a tailnet took this
            # node. Plain `status` is no good — it also fails on a machine that
            # is merely disconnected.
            if "$TS" status --json 2>/dev/null | grep -q '"DNSName": "[^"]'; then
                log_warning "This machine is already on a tailnet — \"create\" would"
                log_warning "rename it there, not add it anywhere new."
                log_info "To be on another tailnet instead:  vpn up <account>"
                return 1
            fi

            log_info "Registering as \"$NAME\" — this prints a login URL"
            $SUDO "$TS" up --accept-routes --hostname="$NAME"
            log_success "\"$NAME\" is on the tailnet"
            log_warning "Now disable key expiry for it, or it drops off in 180 days:"
            log_warning "  https://login.tailscale.com/admin/machines"
            ;;
        ls)
            $SUDO "$TS" switch --list
            ;;
        ip)
            "$TS" ip "$@"
            ;;
        help | -h | --help)
            usage
            ;;
        *)
            log_error "Unknown command: $CMD"
            echo ""
            usage
            return 1
            ;;
    esac
}

if [[ -z "${BASH_SOURCE[0]:-}" || "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
